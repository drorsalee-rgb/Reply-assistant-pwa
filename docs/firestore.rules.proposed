rules_version = '2';

// Proposed rules for the torino-social Firestore — PHASE 1.
//
// Replaces the default "test mode" rule, which lets anyone on the internet
// read AND WRITE every document in the project until 2027-09-04.
//
// THE CONSTRAINT THAT SHAPES EVERYTHING HERE: nothing that talks to this
// project is authenticated.
//   - the mobile app initialises a second Firebase app for torino-social with
//     hardcoded options and NO FirebaseAuth instance (confirmed by Shimon,
//     2026-08-29);
//   - the dashboard calls getAuth() on its yoriki-app instance only, so its
//     torinoFirestore reads carry no token either;
//   - the two PWAs are anonymous by design.
// So `request.auth` is null for every real caller, and any rule requiring a
// signed-in user would take the app and the dashboard down. That is why the
// reads below are public rather than gated.
//
// Backend services (signal-broadcast, pwa-events, claim-social-reactions, the
// orchestrator, the engine) use the Admin SDK and bypass rules entirely, so
// nothing here affects them.
//
// WHAT PHASE 1 BUYS: writes close completely except the two collections the
// dashboard edits, and reads narrow to the handful of collections a client
// actually touches. Volunteers' phone numbers stay readable — see PHASE 2.
//
// PHASE 2, once the dashboard authenticates against torino-social (a small
// change: a getAuth() on the torino app plus a sign-in; two accounts already
// exist in that project): gate fake-hunt-optins, fake-hunt-selections,
// pwa-stats, broadcast-log and debunk-variants behind request.auth != null.
// Until then those stay public, because breaking the operational dashboard is
// worse than the exposure it would remove.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- mobile app (unauthenticated client SDK) ----

    // Read by document id when a link is opened.
    match /social-reactions/{docId} {
      allow get: if true;
      allow list, write: if false;
    }

    // Mandatory-update check.
    match /version-control/{docId} {
      allow get: if true;
      allow list, write: if false;
    }

    // Read by the app, and by the dashboard.
    match /remote-config/{docId} {
      allow get: if true;
      allow list, write: if false;
    }

    // The app holds a live snapshot listener over the whole collection, so
    // `list` is required here — unlike everywhere else. The dashboard also
    // edits these rows, which is the one client write Phase 1 keeps.
    match /content_providers/{docId} {
      allow get, list: if true;
      allow write: if true;   // PHASE 2: require auth (dashboard editing)
    }

    // ---- the two PWAs (anonymous) ----
    // Each is opened from a link that already contains the document id, so
    // `get` is enough. `list` stays denied: without it nobody can enumerate a
    // collection and walk every post or alert we have ever handled.

    match /fake-hunting-messages/{messageId} {
      allow get: if true;
      allow list, write: if false;
    }

    match /debunk-variants/{messageId} {
      // The dashboard lists these to join alerts to their short links.
      allow get, list: if true;
      allow write: if false;
    }

    match /short-links/{code} {
      // /r/<code> resolves by id; the dashboard lists them for click counts.
      allow get, list: if true;
      allow write: if false;   // clicks are counted by pwa-events (Admin SDK)
    }

    // ---- dashboard (unauthenticated, pending PHASE 2) ----

    match /prompt-constants/{docId}         { allow read, write: if true; }
    match /prompt-constants_staging/{docId} { allow read, write: if true; }

    // Volunteers' phone numbers and first names live here. Public only because
    // the dashboard cannot authenticate yet — the first thing PHASE 2 closes.
    match /fake-hunt-optins/{docId}     { allow read: if true; allow write: if false; }
    match /fake-hunt-selections/{docId} { allow read: if true; allow write: if false; }
    match /broadcast-log/{docId}        { allow read: if true; allow write: if false; }

    match /pwa-stats/{docId} {
      allow read: if true;
      allow write: if false;
      // Per-recipient opens, written by pwa-events.
      match /{sub=**} {
        allow read: if true;
        allow write: if false;
      }
    }

    // ---- everything else: server-only ----
    // beacon-chatty, beacon-webhook-events, brief-messages, broadcast-alerts,
    // broadcast-config, channel-brief-*, creator_channels, debunk-feedback,
    // dedupe_message_content, fake-hunt-messages, fake-hunting-config,
    // fake-hunting-requests, groups, reaction-styles-config, slack_event_queue,
    // slack_inline_event_dedupe, slack_posts, users, user_subscriptions,
    // whitelist — none of them is touched by any client, and every service
    // that uses them goes through the Admin SDK.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
